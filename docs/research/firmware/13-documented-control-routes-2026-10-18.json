  "claims": [
    {
      "id": "model-scope",
      "source_id": "U",
      "pdf_pages": [
        135,
        136
      ],
      "classification": "documented",
      "summary": "Easy521 TN/TP is explicitly listed under Easy52X/Easy500; Easy512 is not established by this review."
    },
    {
      "id": "network-default-ip",
      "source_id": "P",
      "pdf_pages": [
        420,
        421
      ],
      "classification": "documented",
      "summary": "Easy52X has two Ethernet ports. 192.168.1.88 and MFK reset are specifically described for H5U; no Easy521 factory IP is established here."
    },
    {
      "id": "modbus-server-default",
      "source_id": "P",
      "pdf_pages": [
        428
      ],
      "classification": "documented",
      "summary": "The documented Modbus TCP server is enabled by default, uses port 502 and allows up to 31 clients; an actual listener on this connected device was not tested."
    },
    {
      "id": "modbus-function-codes",
      "source_id": "P",
      "pdf_pages": [
        428
      ],
      "classification": "documented",
      "summary": "Implemented server function codes are 01/02,03/04,05,06,0F,10; 02 is described as same as 01 and 04 as same as 03."
    },
    {
      "id": "modbus-maps",
      "source_id": "P",
      "pdf_pages": [
        428,
        429
      ],
      "classification": "documented",
      "summary": "Published raw PDU address tables map M/B/S/X/Y coils and D/R words; W and Pointer variables are unsupported. A symbolic global is not automatically the same thing as a D/M address."
    },
    {
      "id": "master-disable-distinction",
      "source_id": "P",
      "pdf_pages": [
        425,
        426,
        427
      ],
      "classification": "documented",
      "summary": "The optional slave-disable section uses _MbTcpMstEx to disable a remote station of the PLC Modbus master; it is not evidence that this toggles the local port-502 server."
    },
    {
      "id": "fins-server-default",
      "source_id": "P",
      "pdf_pages": [
        433
      ],
      "classification": "documented",
      "summary": "H5U/Easy acts only as FINS TCP/UDP slave; service is documented as enabled by default on port 9600; FINS TCP allows 32 clients."
    },
    {
      "id": "fins-commands",
      "source_id": "P",
      "pdf_pages": [
        434
      ],
      "classification": "documented",
      "summary": "The implementation table lists command 01/01 memory read and 01/02 memory write. CPU RUN/STOP command implementation is not established by that table."
    },
    {
      "id": "fins-word-layout",
      "source_id": "P",
      "pdf_pages": [
        434
      ],
      "classification": "documented",
      "summary": "All mapped DM addresses are accessed as WORD, including 16 packed X/Y/M bits per word; X/Y soft-device labels are octal. Do not access across map gaps; max continuous quantity is 2000 words; node/IP last byte limit is 254."
    },
    {
      "id": "fins-udp-run",
      "source_id": "P",
      "pdf_pages": [
        434
      ],
      "classification": "documented",
      "summary": "FINS UDP explicitly requires the PLC to be in Run. FINS TCP STOP-state availability is not established by this clause."
    },
    {
      "id": "opcua-supported-config",
      "source_id": "P",
      "pdf_pages": [
        625,
        626
      ],
      "classification": "documented",
      "summary": "Easy500 including Easy52X supports OPC UA; Easy firmware >=6.3.0.0 with AutoShop >=4.10.1.0 is stated. Server activation is configured in the project; default port is 4840, not proof the server is currently active."
    },
    {
      "id": "opcua-publish-access",
      "source_id": "P",
      "pdf_pages": [
        623,
        624,
        629
      ],
      "classification": "documented",
      "summary": "Private globals are not registered and cannot be read/written via OPC UA; public and input/output globals are registered with read/write permission within registration limits. Supported basic types include BOOL/BYTE/INT/DINT/REAL/STRING."
    },
    {
      "id": "opcua-limits",
      "source_id": "P",
      "pdf_pages": [
        624,
        626
      ],
      "classification": "documented",
      "summary": "Limits include 2000 public variables,20000 basic elements; Easy52X max sessions=20. Arrays/structures and V6.12 enhancements have additional version requirements; minimum sampling can be 100ms, so this is not a 5ms scan trace guarantee."
    },
    {
      "id": "opcua-stop-exception",
      "source_id": "P",
      "pdf_pages": [
        622
      ],
      "classification": "documented",
      "summary": "An already running OPC UA server remains running when PLC goes to Stop; stop/run or power cycling without a project configuration change preserves server activation logic. Do not generalize the PLC STOP overview into all network services being unavailable."
    },
    {
      "id": "opcua-authentication",
      "source_id": "P",
      "pdf_pages": [
        627,
        628
      ],
      "classification": "documented",
      "summary": "The manual describes security policy choices and authentication; anonymous login is checked by default in configuration. This is not a claim that any reachable installation permits anonymous access."
    },
    {
      "id": "cpu-run-stop",
      "source_id": "P",
      "pdf_pages": [
        90,
        168
      ],
      "classification": "documented",
      "summary": "Documented CPU mode control is physical RUN/STOP switch or AutoShop toolbar. M8000 is a read-only running flag; M8001 is its inverse; these are not CPU control bits. Neither is included in the default M0-M7999 protocol mapping."
    },
    {
      "id": "bind-global-soft-device",
      "source_id": "P",
      "pdf_pages": [
        123,
        124
      ],
      "classification": "documented",
      "summary": "Binding a named global to a soft-device address requires filling the variable-table address and compiling the project. BOOL binds a bit device; INT uses one word; DINT/REAL use two consecutive words."
    },
    {
      "id": "ethernet-not-poe",
      "source_id": "U",
      "pdf_pages": [
        137,
        138
      ],
      "classification": "documented",
      "summary": "EtherNET1/2 and EtherCAT are explicitly non-PoE; linking a cable is not a documented power source. RUN and ETH indicators denote different facts."
    },
    {
      "id": "power-and-usb",
      "source_id": "U",
      "pdf_pages": [
        138,
        139,
        140,
        141
      ],
      "classification": "documented",
      "summary": "Easy52X main terminal input and physical input/output voltage ratings are 24VDC +/-10%. USB-only operation is mentioned with a no-power-loss-retention limitation; Type-C supports application upload/download and firmware upgrade. The cited pages do not establish USB-only CPU or Ethernet runtime behavior."
    },
    {
      "id": "no-st-download-contract",
      "source_id": "P",
      "pdf_pages": [
        428,
        434,
        623,
        624
      ],
      "classification": "bounded-document-review",
      "summary": "Reviewed Modbus/FINS/OPC UA implementation sections describe data/variable access, not an arbitrary ST source download/build/link/application transaction. A business command variable is not a generic PLC program loader."
    }
  ],
