  "practical_order": [
    {
      "route": "modbus-tcp",
      "value": "Simplest documented raw D/M read/write route when live IP,link and service are known; no new protocol configuration is stated for the standard server",
      "does_not_do": "Does not expose arbitrary private named globals or load ST"
    },
    {
      "route": "one-time-addressed-app-interface",
      "value": "A deliberately bound command/status D/M interface lets an existing running application interpret external commands",
      "does_not_do": "Business START is not CPU RUN; behavior requires the application to execute"
    },
    {
      "route": "opcua",
      "value": "Named typed variables without a D map after project activation and publication",
      "does_not_do": "Does not register current BESS private variables automatically"
    },
    {
      "route": "fins",
      "value": "Alternative documented word-level access; bit writes affect packed words",
      "does_not_do": "No generic FINS CPU mode or ST application download implementation established"
    }
  ],
  "corrections_to_prior_notes": [
    "Manual default-enabled language is real but is not live endpoint observation.",
    "Optional _MbTcpMstEx slave-disable is for a PLC master remote station, not proof of a local-server disable switch.",
    "STOP does not imply every service is down: OPC UA has an explicit survival rule.",
    "D/R raw mapping does not imply current private g_* globals are D-mapped.",
    "Type-C vendor support is documented; third-party impossibility is not proved.",
    "H5U 192.168.1.88 is not established as Easy521 default IP.",
    "Logical Y image access does not by itself prove terminal energization, write persistence or priority over scan logic."
  ]
}
